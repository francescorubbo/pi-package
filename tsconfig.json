{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@earendil-works/pi-ai/*": ["node_modules/@earendil-works/pi-coding-agent/node_modules/@earendil-works/pi-ai/*"],
      "@earendil-works/pi-ai": ["node_modules/@earendil-works/pi-coding-agent/node_modules/@earendil-works/pi-ai"],
      "@earendil-works/chord/*": ["node_modules/@earendil-works/pi-coding-agent/node_modules/@earendil-works/chord/*"],
      "@earendil-works/chord": ["node_modules/@earendil-works/pi-coding-agent/node_modules/@earendil-works/chord"],
      "@earendil-works/pi-tui/*": ["node_modules/@earendil-works/pi-coding-agent/node_modules/@earendil-works/pi-tui/*"],
      "@earendil-works/pi-tui": [
        "node_modules/@earendil-works/pi-tui/dist/index.d.ts",
        "node_modules/@earendil-works/pi-coding-agent/node_modules/@earendil-works/pi-tui/dist/index.d.ts"
      ]
    }
  },
  "include": ["extensions/**/*", "test/**/*"]
}
