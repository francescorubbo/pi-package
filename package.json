{
  "name": "pi-package",
  "version": "0.1.0",
  "description": "Custom extensions for pi-coding-agent",
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions/block-shell-commands.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "typebox": "latest"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "typescript": "^5.0.0"
  },
  "lint-staged": {
    "extensions/*.ts": [
      "npm run typecheck"
    ]
  }
}
